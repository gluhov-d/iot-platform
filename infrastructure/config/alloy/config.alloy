// Сбор логов Docker-контейнеров -> Loki, приём OTLP-трейсов -> Tempo.

logging {
  level  = "warn"
  format = "logfmt"
}

// ------------------------------------------------------------------ логи
discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"

  // Только контейнеры текущего Compose-проекта: логи соседних проектов
  // с такими же сервисами (redis, postgres, kafka) не попадут в панели платформы
  filter {
    name    = "label"
    values  = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { job = "docker", cluster = sys.env("COMPOSE_PROJECT_NAME") }
  forward_to = [loki.process.json_logs.receiver]
}

// JSON-логи events-collector-service: уровень - метка (низкая кардинальность),
// traceId/eventId/deviceId - structured metadata: по ним можно фильтровать,
// но они не раздувают индекс Loki, как раздули бы метки.
loki.process "json_logs" {
  stage.match {
    selector = "{service=\"events-collector-service\"}"

    stage.json {
      expressions = {
        level    = "level",
        trace_id = "traceId",
        event_id = "eventId",
        device_id = "deviceId",
      }
    }

    stage.labels {
      values = { level = "" }
    }

    stage.structured_metadata {
      values = { trace_id = "", event_id = "", device_id = "" }
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

// ---------------------------------------------------------------- трейсы
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4319" }
  http { endpoint = "0.0.0.0:4320" }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls { insecure = true }
  }
}
