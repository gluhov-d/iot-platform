<clickhouse>
    <!-- Named collection backup_s3 для BACKUP/RESTORE в MinIO (ADR-0017, research.md R17).
         Адрес и ключи берутся из окружения контейнера clickhouse (from_env), в тексте запроса их нет.
         Адрес включает бакет и префикс: http://minio:9000/<бакет>/clickhouse/ - копия <метка> лежит в нём. -->
    <named_collections>
        <backup_s3>
            <url from_env="BACKUP_CLICKHOUSE_S3_URL"/>
            <access_key_id from_env="BACKUP_CLICKHOUSE_S3_ACCESS_KEY"/>
            <secret_access_key from_env="BACKUP_CLICKHOUSE_S3_SECRET_KEY"/>
        </backup_s3>
    </named_collections>
</clickhouse>
