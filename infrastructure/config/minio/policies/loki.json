{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "loki-chunks-bucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::__BUCKET_LOKI__"]
    },
    {
      "Sid": "loki-chunks-objects",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::__BUCKET_LOKI__/*"]
    }
  ]
}
