{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "mimir-blocks-bucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": ["arn:aws:s3:::__BUCKET_MIMIR__"]
    },
    {
      "Sid": "mimir-blocks-objects",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::__BUCKET_MIMIR__/*"]
    }
  ]
}
