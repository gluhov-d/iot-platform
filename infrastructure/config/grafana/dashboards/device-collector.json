{
  "uid": "device-collector",
  "title": "IoT Platform — device-collector-service",
  "tags": [
    "iot-platform",
    "device-collector"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "status",
        "label": "status в логах",
        "type": "custom",
        "query": ".*,APPLIED,STALE,DUPLICATE,FAILED,REJECTED,DLT",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "shard",
        "label": "shard в логах",
        "type": "custom",
        "query": ".*,shard_0,shard_1,unknown",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Сводка за выбранный интервал",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Экземпляры UP",
      "description": "Сколько реплик сервиса отдают метрики",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(up{job=\"device-collector-service\"})"
        }
