      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bucket) (minio_cluster_usage_buckets_objects_count)",
          "legendFormat": "{{bucket}}"
        }
      ]
