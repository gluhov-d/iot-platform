{
  "uid": "events-collector",
  "title": "IoT Platform — events-collector-service",
  "tags": [
    "iot-platform",
    "events-collector"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "status",
        "label": "status в логах",
        "type": "custom",
        "query": ".*,PROCESSED,PUBLISHED,SKIPPED,FAILED,REJECTED,ERROR",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [],
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
