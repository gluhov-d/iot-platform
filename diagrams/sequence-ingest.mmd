%% Прием события: at-least-once, offset подтверждается только после записи в обе таблицы
%% или после публикации FailedEvent в failed-events. Реестр устройств: событие может нести данные устройства (DeviceEvent 1.2: имя, ОС и её версия, прошивка)
sequenceDiagram
    autonumber
    participant K as Kafka (events)
    participant SR as Schema Registry
    participant C as ErrorHandlingDeserializer
    participant L as KafkaEventListener
    participant H as DefaultErrorHandler
    participant S as EventIngestionService
    participant V as DeviceEventValidator
    participant CE as ClickHouse device_events
    participant CO as ClickHouse device_outbox
    participant D as Kafka (failed-events)

    K->>C: poll (max.poll.records=1, enable.auto.commit=false)
    C->>C: RawKeepingDeserializer: исходные байты key и value (без копии и пересериализации) → заголовки записи x-raw-key, x-raw-value, до разбора Avro
    C->>SR: схема по id (KafkaAvroDeserializer, кешируется)
    alt Schema Registry не ответил (сеть, 5xx)
        SR--xC: ошибка
        C-->>H: DeserializationException - временная
        break повтор без лимита попыток, смещение не подтверждается
            Note over H,K: пауза по EVENTS_RETRY_INTERVAL с ростом EVENTS_RETRY_MULTIPLIER, FailedEvent не создаётся
        end
    else не Avro / схема не найдена
        C-->>H: DeserializationException - «ядовитое» сообщение
        H->>D: FailedEvent DESERIALIZATION_FAILED, key и value — исходные байты из заголовков x-raw-key, x-raw-value
        alt публикация принята (acks=all)
            D-->>H: ack
            H->>K: commit offset после публикации FailedEvent
            break сообщение обработано, дальше схема не идёт
                Note over H,K: FailedEvent опубликован, смещение подтверждено
            end
        else failed-events недоступна (тайм-аут send().get)
            D--xH: ошибка публикации
            break смещение events не подтверждается
                Note over H,K: сообщение будет обработано снова после восстановления, не теряется
            end
        end
    else DeviceEvent (SpecificRecord, контракт avros 1.0 – 1.2)
        SR-->>C: схема
        C->>L: DeviceEvent
        L->>L: MDC: topic, partition, offset, eventId, deviceId
        L->>S: ingest(event)
        S->>V: validate(eventId, deviceId, eventType, timestampMs, device)
        alt событие невалидно (в т. ч. device.deviceId ≠ deviceId)
            V-->>S: InvalidEventException
            S-->>H: исключение - не повторяется
            H->>D: FailedEvent VALIDATION_FAILED, key и value — исходные байты из x-raw-key, x-raw-value (не DeviceEvent, пересериализованный из объекта)
            alt публикация принята (acks=all)
                D-->>H: ack
                H->>K: commit offset после публикации FailedEvent, лог status=FAILED_EVENT
                break сообщение обработано, дальше схема не идёт
                    Note over H,K: FailedEvent опубликован, смещение подтверждено
                end
            else failed-events недоступна (тайм-аут send().get)
                D--xH: ошибка публикации
                break смещение events не подтверждается
                    Note over H,K: сообщение будет обработано снова после восстановления, не теряется
                end
            end
        else событие валидно
            S->>S: event_date = дата в UTC, ingested_at = now<br/>device_snapshot = снимок в Avro JSON, '' - если снимка нет
            S->>CE: INSERT device_events (+ device_snapshot, device_name, os_name, os_version,<br/>firmware_version, source_system, payload) - колонки добавлены ADD COLUMN IF NOT EXISTS
            alt ошибка записи
                CE-->>S: ошибка
                S-->>H: EventPersistenceException (events_persist_fail_total++)
                loop до EVENTS_MAX_ATTEMPTS попыток, пауза растёт экспоненциально со случайным разбросом
                    H->>L: повтор того же сообщения
                end
                H->>D: FailedEvent STORAGE_UNAVAILABLE, key и value — исходные байты из x-raw-key, x-raw-value, attempts = N
                alt публикация принята (acks=all)
                    D-->>H: ack
                    H->>K: commit offset после публикации FailedEvent, лог status=FAILED_EVENT
                    break сообщение обработано, дальше схема не идёт
                        Note over H,K: FailedEvent опубликован, смещение подтверждено
                    end
                else failed-events недоступна (тайм-аут send().get)
                    D--xH: ошибка публикации
                    break смещение events не подтверждается
                        Note over H,K: сообщение будет обработано снова после восстановления, не теряется
                    end
                end
            else записано
                S->>CO: INSERT device_outbox (state_version=1, NEW, attempts=0, device_snapshot,<br/>trace_id/span_id текущего спана - для сквозного трейса)
                alt ошибка записи
                    CO-->>S: ошибка
                    S-->>H: EventPersistenceException
                    loop до EVENTS_MAX_ATTEMPTS попыток, как выше
                        H->>L: повтор того же сообщения
                    end
                    Note over H,D: повторная строка device_events схлопнется ReplacingMergeTree
                    H->>D: FailedEvent STORAGE_UNAVAILABLE, key и value — исходные байты из x-raw-key, x-raw-value, attempts = N
                    alt публикация принята (acks=all)
                        D-->>H: ack
                        H->>K: commit offset после публикации FailedEvent, лог status=FAILED_EVENT
                        break сообщение обработано, дальше схема не идёт
                            Note over H,K: FailedEvent опубликован, смещение подтверждено
                        end
                    else failed-events недоступна (тайм-аут send().get)
                        D--xH: ошибка публикации
                        break смещение events не подтверждается
                            Note over H,K: сообщение будет обработано снова после восстановления, не теряется
                        end
                    end
                else записано
                    S-->>L: ok (events_processed_total++, outbox_candidate_created_total++)
                    L->>K: ack.acknowledge() - commit offset
                    break сообщение обработано, дальше схема не идёт
                        Note over L,K: событие записано в обе таблицы, смещение подтверждено
                    end
                end
            end
        end
    end
