%% Компоненты device-collector-service и его окружение (реестр устройств)
flowchart LR
    ecs(["events-collector-service<br/>outbox → DeviceInfo"])

    subgraph kafka["Kafka 4.2 (KRaft) и Schema Registry"]
        devices[["devices<br/>ключ deviceId · 3 раздела<br/>cleanup.policy=compact"]]
        dlt[["devices-dlt<br/>3 раздела · cleanup.policy=delete"]]
        sr[("Schema Registry<br/>devices-value · FULL")]
    end

    subgraph svc["device-collector-service (до 3 реплик, одна consumer group)"]
        direction TB
        listener["DeviceInfoListener<br/>adapter.in.kafka<br/>max.poll.records=1 · manual ack"]
        errors["DefaultErrorHandler<br/>+ DeadLetterPublishingRecoverer<br/>3 попытки при ошибке БД (пауза растёт экспоненциально,<br/>со случайным разбросом), валидация — сразу,<br/>Schema Registry недоступен — без ограничения<br/>число попыток и паузы — из переменных окружения"]
        api["DeviceController<br/>adapter.in.web<br/>GET /api/v1/devices/{deviceId}"]
        query["DeviceQueryService<br/>domain.service"]
        registry["DeviceRegistryService<br/>domain.service"]
        validator["DeviceInfoValidator<br/>domain.service"]
        repo["JdbcDeviceRepository · JdbcTransactionRunner<br/>adapter.out.postgres · JdbcClient"]
        shards["ProxyShardResolver<br/>adapter.out.postgres<br/>PREVIEW — только на пути ошибки, кеш 5 мин"]
        metrics["MetricsFacade (порт DeviceMetrics)<br/>devices_* · метка shard"]

        listener --> registry
        registry --> validator
        registry --> repo
        registry -.-> shards
        registry -.-> metrics
        api --> query
        query --> repo
        listener -. "исключение" .-> errors
    end

    subgraph store["Реестр устройств"]
        proxy["ShardingSphere-Proxy 5.5.3<br/>логическая база devices<br/>INLINE: |hashCode(device_id)| % 2 · bindingTables"]
        s0[("postgres-shard-0 · shard_0<br/>devices · processed_device_events")]
        s1[("postgres-shard-1 · shard_1<br/>devices · processed_device_events")]
        r0[("postgres-shard-0-replica<br/>hot standby, только чтение")]
        r1[("postgres-shard-1-replica<br/>hot standby, только чтение")]
    end
    migrator["db-migrator<br/>Flyway · одноразовый<br/>до старта Proxy и сервиса"]

    subgraph obs["Наблюдаемость (профиль observability)"]
        prom["Prometheus"]
        alloy["Grafana Alloy"]
        tempo["Tempo"]
        loki["Loki"]
    end

    ecs -- "DeviceInfo (Avro), traceparent" --> devices
    devices -- "poll по одному" --> listener
    listener -. "схема по id" .- sr
    errors -- "DeviceInfo (Avro) или исходные байты · kafka_dlt-*" --> dlt
    repo -- "BEGIN · SELECT … FOR UPDATE · INSERT журнал ON CONFLICT DO NOTHING · INSERT / UPDATE devices · RETURNING current_database() · COMMIT" --> proxy
    shards -- "PREVIEW SELECT … WHERE device_id" --> proxy
    proxy -- "device_id → shard_0" --> s0
    proxy -- "device_id → shard_1" --> s1
    migrator -- "V*.sql (IF NOT EXISTS) напрямую,<br/>по очереди; затем сверка версий" --> s0
    migrator -- "V*.sql (IF NOT EXISTS) напрямую,<br/>по очереди; затем сверка версий" --> s1
    s0 -. "потоковая репликация WAL" .-> r0
    s1 -. "потоковая репликация WAL" .-> r1

    prom -- "/actuator/prometheus" --> svc
    prom -- "метрики Proxy (агент)" --> proxy
    svc -- "логи stdout JSON · трейсы OTLP" --> alloy
    alloy --> loki
    alloy --> tempo
