%% Компоненты failed-events-processor и его окружение (архив ошибок в MinIO)
flowchart LR
    ecs(["events-collector-service и device-collector-service<br/>FailedEvent после N попыток"])

    subgraph kafka["Kafka 4.2 (KRaft) и Schema Registry"]
        failed[["failed-events<br/>ключ sourceTopic-sourcePartition-sourceOffset · 3 раздела<br/>cleanup.policy=delete · retention.ms = KAFKA_FAILED_EVENTS_RETENTION_MS"]]
        sr[("Schema Registry<br/>failed-events-value · FULL_TRANSITIVE")]
    end

    subgraph svc["failed-events-processor (до 3 реплик, одна consumer group)"]
        direction TB
        listener["FailedEventListener<br/>adapter.in.kafka<br/>ErrorHandlingDeserializer · Avro FailedEvent<br/>max.poll.records=1 · manual ack"]
        service["ArchiveService<br/>domain.service<br/>тело — JSON со всеми полями FailedEvent<br/>(байты ключа, значения и заголовков — base64)<br/>ключ объекта строит ArchiveKey"]
        model["FailedRecord · ArchiveKey<br/>domain.model<br/>ArchiveKey: yyyy/MM/dd/failed-events-p-o.json по разделу, смещению<br/>и времени записи failed-events — одинаков для читаемой и нечитаемой записи"]
        port["FailedEventArchive<br/>domain.port"]
        s3["S3FailedEventArchive<br/>adapter.out.s3 (порт FailedEventArchive)<br/>PutObject If-None-Match: * · x-amz-meta-*<br/>apiCallTimeout 8 с · apiCallAttemptTimeout 4 с<br/>412 — объект уже записан"]
        unreadable["UnreadableRecorder<br/>domain.service<br/>тело unreadable — байты, причина; ключ объекта тот же ArchiveKey,<br/>смещение подтверждается после записи"]
        errors["DefaultErrorHandler<br/>бесконечный ExponentialBackOff (max 10 с)<br/>+ ContainerPausingBackOffHandler<br/>MinIO недоступен — повтор, смещение не подтверждается"]
        metrics["MetricsFacade (support)<br/>failed.events.archived{source_service, error_code, outcome}<br/>таймер s3.put-object, ошибки записи"]
        tracing["Спан s3.put-object (Observation, тег bucket)<br/>дочерний спан слушателя той же трассы"]

        listener --> service
        service --> model
        service --> port
        port -.-> s3
        unreadable --> port
        listener -. "нечитаемо" .-> unreadable
        listener -. "исключение" .-> errors
        service -.-> metrics
        s3 -.-> tracing
    end

    minio[("MinIO · бакет failed-events<br/>yyyy/MM/dd/failed-events-p-o.json — один ключ для всех объектов (дата — время записи failed-events, p и o — раздел и смещение)<br/>sourceService, errorCode, sourceTopic, deviceId, traceId — в теле и метаданных · срок 180 суток")]

    subgraph obs["Наблюдаемость"]
        alloy["Grafana Alloy"]
        mimir[("Mimir")]
        loki[("Loki")]
        tempo[("Tempo")]
    end

    ecs -- "FailedEvent (Avro), traceparent" --> failed
    failed -- "poll по одному" --> listener
    listener -. "схема по id" .- sr
    s3 -- "PutObject If-None-Match: * · S3 API" --> minio
    svc -- "логи stdout JSON · трейсы OTLP" --> alloy
    alloy -- "/actuator/prometheus, все экземпляры" --> svc
    alloy -- "remote write" --> mimir
    alloy --> loki
    alloy --> tempo
