%% C4 Level 2 — контейнеры IoT-платформы. Маршруты: T — телеметрия и реестр устройств, A — управление устройствами
%% (запись через device-service), Q — чтение устройства (Cache-Aside), C — команды роутерам (router-manager, gRPC), E — ошибки (failed-events),
%% S — объектное хранилище MinIO (S3 API), B — сборка, схема БД, бакеты и копии, M — метрики, L — логи, R — трейсы.
%% Сплошные линии — данные и команды, пунктир — остальное.
flowchart LR
    engineer(["<b>Инженер</b><br/>Регистрирует устройства, отправляет<br/>команды, смотрит телеметрию"])
    device["<b>IoT-устройство</b><br/>Датчик/контроллер: шлёт телеметрию"]
    router["<b>Роутер</b><br/>Опрашивает команды, выполняет, сообщает результат;<br/>ключ выведен из мастер-ключа. На стенде —<br/>router-emulator (Go, профиль emulator)"]
    subgraph platform["IoT Platform"]
        subgraph apps["Прикладные сервисы · Spring Boot, Go"]
            gateway["<b>API Gateway</b><br/><i>Spring Cloud Gateway</i><br/>Единая точка входа прикладного API:<br/>проверка пользовательского JWT, маршрутизация"]
            orchestrator["<b>API Orchestrator</b><br/><i>Spring Boot</i><br/>Сценарии из нескольких шагов. К device-service<br/>ходит через device-service-client<br/>со своим сервисным токеном"]
            device_service["<b>device-service</b> ×2<br/><i>Spring Boot 4, OAuth2 Resource Server</i><br/>REST CRUD устройств, API First. Запись не хранит:<br/>DeviceInfo с operation в devices, 202 после ack.<br/>Чтение: Redis, промах — реплики через Proxy.<br/>Только сервисные токены, без состояния"]
            router_manager["<b>router-manager</b> ×2<br/><i>Go 1.26, gRPC, pgx</i><br/>Команды роутерам: NEW → SENT → SUCCESS / FAILED.<br/>Администратор — сервисный JWT, роутер — подпись HMAC<br/>с телом и одноразовостью.<br/>Выдача ровно один раз (SKIP LOCKED), негативный кэш<br/>в Redis; SENT дольше срока → FAILED и оповещение"]
            event_service["<b>Event Service</b><br/><i>Spring Boot</i><br/>Чтение телеметрии и событий для API"]
            device_gateway["<b>Device Gateway</b><br/><i>Spring Boot, MQTT/HTTP adapter</i><br/>Протокольный шлюз устройств: принимает<br/>MQTT/HTTP, проверяет устройство, публикует<br/>в Kafka"]
            events_collector["<b>events-collector-service</b><br/><i>Spring Boot 4, Kafka consumer</i><br/>events -> ClickHouse (device_events с данными<br/>устройства + outbox); DeviceInfo в devices<br/>(operation = null) - только новое устройство<br/>или изменённые данные. После N попыток записи —<br/>FailedEvent в failed-events"]
            device_collector["<b>device-collector-service</b><br/><i>Spring Boot 4, Kafka consumer</i><br/>Единственный писатель реестра устройств:<br/>события роутера и команды CREATE / UPDATE /<br/>DELETE, идемпотентно; после COMMIT<br/>сбрасывает кэш устройства. Невалидное или<br/>недоступный шард — FailedEvent в failed-events"]
            failed_processor["<b>failed-events-processor</b><br/><i>Spring Boot 4, Kafka consumer, S3 API</i><br/>failed-events → один JSON-объект на сообщение в MinIO.<br/>Смещение — после записи. Повторная доставка<br/>не создаёт второй объект"]
        end
        subgraph kafka["Kafka · Message Broker"]
            topic_events[/"<b>events</b><br/><i>Kafka topic, delete</i><br/>Сырые события устройств (Avro<br/>DeviceEvent), ключ deviceId"/]
            topic_device[/"<b>devices</b><br/><i>Kafka topic, delete, хранение 30 суток</i><br/>DeviceInfo, ключ deviceId: события роутера<br/>(operation = null) и команды device-service<br/>(operation CREATE / UPDATE / DELETE).<br/>Команда несёт все поля администратора.<br/>Хранение вместо сжатия: порядок «команда →<br/>снимок» не теряется (ADR-0011)"/]
            topic_failed[/"<b>failed-events</b><br/><i>Kafka topic, delete, 3 раздела, хранение 14 суток</i><br/>FailedEvent (Avro): исходное сообщение байт в байт,<br/>ключ sourceTopic-sourcePartition-sourceOffset"/]
        end
        schema_registry["<b>Schema Registry</b><br/><i>Confluent</i><br/>Avro-схемы тем, FULL_TRANSITIVE.<br/>Схемы регистрирует только schema-register:<br/>у продюсеров auto.register.schemas=false"]
        avros["<b>avros</b><br/><i>Проект монорепозитория; одноразовые задачи Compose</i><br/>Все Avro-схемы платформы, 1.4.0: DeviceInfo.operation,<br/>FailedEvent. avros-publish: проверка FULL с Nexus и Schema<br/>Registry, публикация. schema-register: регистрация"]
        protos["<b>protos</b><br/><i>Проект монорепозитория; одноразовая задача protos-publish</i><br/>Все .proto платформы, 1.0.0: buf lint, buf breaking<br/>WIRE_JSON с последним релизом, публикация"]
        nexus["<b>Nexus</b><br/><i>Sonatype Nexus 3, Maven</i><br/>avros, protos и device-service-client: выпущенная<br/>версия не перезаписывается, потребители<br/>подключают явную версию"]
        startup["<b>Порядок старта (Docker Compose)</b><br/>Nexus → avros-publish → schema-register →<br/>db-migrator → Proxy; postgres → router-manager-db-init →<br/>db-migrator-router-manager; Nexus → protos-publish; MinIO → minio-init;<br/>Redis + Sentinel, Keycloak (импорт realm) → сервисы.<br/>Каждый шаг ждёт успешного завершения предыдущего"]
        keycloak["<b>Keycloak</b><br/><i>Keycloak 26, realm iot-platform</i><br/>Realm из репозитория импортируется при старте:<br/>клиенты device-service (роли devices.read / write)<br/>и router-manager (commands.read / write),<br/>клиенты-потребители с сервисной учётной записью"]
        minio_init["<b>minio-init</b><br/><i>Одноразовая задача Compose, образ MinIO, /bin/sh</i><br/>Бакеты, учётки, политики и ILM при запуске стенда"]
        backup_runner["<b>backup-runner</b><br/><i>busybox crond, расписание BACKUP_SCHEDULE</i><br/>Копии PostgreSQL (pg_dump с реплик) и ClickHouse<br/>(BACKUP) в бакет backups, по префиксам"]
        subgraph registry["Реестр устройств"]
            proxy["<b>ShardingSphere-Proxy</b><br/><i>Apache ShardingSphere 5.5.3, PostgreSQL protocol</i><br/>Маршрут #124;hashCode(device_id)#124; % 2. Логические базы:<br/>devices — основные узлы (запись, только DCS),<br/>devices_read — только реплики (чтение device-service)"]
            shard0[("<b>postgres-shard-0</b><br/><i>PostgreSQL 18, primary, база shard_0</i><br/>devices, processed_device_events — часть<br/>устройств")]
            shard1[("<b>postgres-shard-1</b><br/><i>PostgreSQL 18, primary, база shard_1</i><br/>devices, processed_device_events —<br/>остальные устройства")]
            replica0[("<b>postgres-shard-0-replica</b><br/><i>PostgreSQL 18, hot standby</i><br/>Только чтение: источник devices_read,<br/>роль device_reader")]
            replica1[("<b>postgres-shard-1-replica</b><br/><i>PostgreSQL 18, hot standby</i><br/>Только чтение: источник devices_read,<br/>роль device_reader")]
            db_migrator["<b>db-migrator</b><br/><i>Java 25, Flyway 12.11</i><br/>Одноразовая задача: миграции (IF NOT EXISTS)<br/>напрямую на primary каждого шарда,<br/>сверка версий схемы; второй запуск —<br/>iot_commands"]
        end
        pg[("<b>PostgreSQL</b><br/><i>PostgreSQL 16, базовый стенд</i><br/>iot_commands: router_commands<br/>(роль router_manager); БД Camunda")]
        subgraph redis_ha["Redis · общий для платформы"]
            sentinel["<b>redis-sentinel</b> ×3<br/><i>Redis Sentinel, кворум 2</i><br/>Следит за master platform-redis,<br/>при отказе назначает новый; клиенты<br/>узнают адрес master у Sentinel"]
            redis[("<b>redis</b> (master) + <b>redis-replica</b><br/><i>Redis 8</i><br/>outbox:lease, devices:published, devices:fingerprint;<br/>кэш device:cache:v1:{deviceId} — данные и version (TTL кэша);<br/>device:floor:v1:{deviceId} — минимальная версия для<br/>записи, свой срок DEVICE_CACHE_FLOOR_TTL;<br/>router:cmd:none:v1:{routerId}, router:cmd:gen:v1:{routerId},<br/>router:sig:v1 — принятые подписи роутеров (120 с)")]
        end
        clickhouse[("<b>ClickHouse</b><br/><i>Колоночная БД</i><br/>iot_platform: device_events, device_outbox<br/>(ReplacingMergeTree),<br/>device_publication_audit (MergeTree)")]
        minio[("<b>MinIO</b><br/><i>Object Storage, одна нода</i><br/>Бакеты failed-events, mimir-blocks, loki-chunks,<br/>tempo-traces, backups (префиксы postgres/, clickhouse/)")]
        camunda["<b>Camunda</b><br/><i>BPM Engine</i><br/>Процессы API-оркестратора (план);<br/>команды роутерам — через router-manager"]
        subgraph obs["Наблюдаемость"]
            alloy["<b>Alloy</b><br/><i>Grafana Alloy</i><br/>Агент: читает логи контейнеров проекта<br/>через Docker API, принимает OTLP-трейсы,<br/>скрейпит метрики сервисов и экспортёров,<br/>remote write в Mimir"]
            mimir[("<b>Mimir</b><br/><i>Grafana Mimir 3.2.6, монолит</i><br/>Метрики (remote write от Alloy), blocks и ruler в MinIO")]
            loki[("<b>Loki</b><br/><i>Log storage</i><br/>Логи JSON с traceId; chunks и индекс в MinIO,<br/>метки service, container")]
            tempo[("<b>Tempo</b><br/><i>Trace storage</i><br/>Трейсы; блоки в MinIO")]
            pg_exporter["<b>postgres-exporter</b><br/><i>Экспортёр метрик</i><br/>Метрики PostgreSQL платформы, шардов и<br/>реплик, отставание реплик"]
            kafka_exporter["<b>kafka-exporter</b><br/><i>Экспортёр метрик</i><br/>Метрики Kafka на :9308"]
            grafana["<b>Grafana</b><br/><i>Dashboards</i><br/>Панели events-collector, device-collector,<br/>device-service, failed-events-processor, router-manager,<br/>MinIO, PostgreSQL; оповещение о зависших командах"]
        end
    end
    docker["<b>Docker Engine</b><br/>Логи контейнеров, метки Compose-проекта"]

    %% Вход инженера
    engineer -- "Вход, пользовательский токен · OIDC" --> keycloak
    engineer -- "Прикладной API с JWT · HTTPS/REST" --> gateway
    gateway -- "Проверка JWT (JWKS) · OIDC" --> keycloak
    gateway -- "Составные операции · REST" --> orchestrator
    gateway -- "Запросы телеметрии · REST" --> event_service
    %% T: приём телеметрии и реестр устройств
    device -- "T1. Телеметрия, состояние устройства · MQTT/HTTP" --> device_gateway
    device_gateway -- "T2. Устройство известно и активно? · Redis" --> redis
    device_gateway -- "T3. DeviceEvent с данными устройства · Kafka, Avro" --> topic_events
    events_collector -- "T4. Чтение, ack после записи · Kafka" --> topic_events
    events_collector -- "T5. device_events + outbox с данными<br/>устройства; сбой записи - N попыток · JDBC/HTTP" --> clickhouse
    events_collector -- "T6. Аренда публикатора; отпечаток<br/>опубликованных данных · Redis" --> redis
    events_collector -- "T7. DeviceInfo (operation = null), если устройство<br/>новое или его данные изменились · Kafka, Avro" --> topic_device
    device_collector -- "T8. Чтение по одному, ack после COMMIT<br/>и сброса кэша · Kafka" --> topic_device
    device_collector -- "T9. Журнал + состояние устройства в одной<br/>транзакции, RETURNING version · JDBC, база devices" --> proxy
    proxy -- "T10. Маршрут по device_id · JDBC" --> shard0
    proxy -- "T10. Маршрут по device_id · JDBC" --> shard1
    device_gateway -- "Схемы Avro · HTTP" --> schema_registry
    events_collector -- "Схемы Avro по ID, без авторегистрации · HTTP" --> schema_registry
    device_collector -- "Схемы Avro по ID · HTTP" --> schema_registry
    device_service -- "Схемы Avro по ID, без авторегистрации · HTTP" --> schema_registry
    failed_processor -- "Схемы Avro по ID, без авторегистрации · HTTP" --> schema_registry
    event_service -- "Выборки телеметрии · HTTP/SQL" --> clickhouse
    %% A: управление устройствами (запись через Kafka)
    orchestrator -- "A1. Сервисный токен · OAuth2 client credentials" --> keycloak
    orchestrator -- "A2. POST / PUT / DELETE /api/v1/devices + JWT<br/>· REST (device-service-client)" --> device_service
    device_service -- "A3. Ключи JWKS (кэш, обновление по kid) · HTTP" --> keycloak
    device_service -- "A4. DeviceInfo: operation, eventId, поля администратора;<br/>ключ deviceId, acks=all; 202 только после ack · Kafka, Avro" --> topic_device
    device_collector -- "A5. После COMMIT: floor = version в device:floor:v1:{id},<br/>старые данные удалить (Lua) · Redis master, адрес от Sentinel" --> redis
    %% Q: чтение устройства (Cache-Aside)
    orchestrator -- "Q1. GET /api/v1/devices/{deviceId} + JWT<br/>· REST (device-service-client)" --> device_service
    device_service -- "Q2. device:cache:v1:{deviceId}; при промахе - запись, только если<br/>version ≥ floor (Lua), затем порог снимается · Redis master" --> redis
    device_service -- "Q3. Промах: SELECT по device_id,<br/>база devices_read · JDBC" --> proxy
    proxy -- "Q4. devices_read: маршрут по device_id · JDBC" --> replica0
    proxy -- "Q4. devices_read: маршрут по device_id · JDBC" --> replica1
    apps -. "Адрес текущего master · Sentinel :26379" .-> sentinel
    sentinel -. "Наблюдение, failover" .-> redis
    %% B: сборка, схема БД, бакеты и копии
    events_collector -. "B1. Сборка: avros 1.4.0, явная версия · Maven" .-> nexus
    device_collector -. "B1. Сборка: avros 1.4.0, явная версия · Maven" .-> nexus
    failed_processor -. "B1. Сборка: avros 1.4.0, явная версия · Maven" .-> nexus
    device_service -. "B1. Сборка: avros 1.4.0; B3. публикация<br/>device-service-client (DTO + HTTP Service Client<br/>из OpenAPI) · Maven" .-> nexus
    orchestrator -. "B4. Подключает device-service-client<br/>явной версии · Maven" .-> nexus
    db_migrator -. "B2. Flyway migrate · JDBC" .-> shard0
    db_migrator -. "B2. Flyway migrate · JDBC" .-> shard1
    avros -. "B0. Проверка FULL с зарегистрированными<br/>версиями; после публикации - регистрация · HTTP" .-> schema_registry
    avros -. "B0. Публикация артефакта avros (версия<br/>не перезаписывается) · Maven" .-> nexus
    protos -. "B0. buf breaking с последним релизом; публикация<br/>protos (версия не перезаписывается) · Maven" .-> nexus
    router_manager -. "B1. Сборка: protos 1.0.0 из Nexus → buf generate · Maven" .-> nexus
    db_migrator -. "B2. Flyway migrate, база iot_commands · JDBC" .-> pg
    minio_init -. "B5. Бакеты, учётки, политики, ILM · S3 API (mc)" .-> minio
    backup_runner -. "B6. pg_dump с реплик, manifest · JDBC" .-> replica0
    backup_runner -. "B6. pg_dump с реплик, manifest · JDBC" .-> replica1
    backup_runner -. "B7. BACKUP DATABASE … TO S3, ключи из<br/>named collection · HTTP" .-> clickhouse
    backup_runner -. "B8. позиции группы · Kafka protocol" .-> kafka
    shard0 -. "Потоковая репликация WAL (асинхронная)" .-> replica0
    shard1 -. "Потоковая репликация WAL (асинхронная)" .-> replica1
    %% E: ошибки — failed-events
    events_collector -. "E1. N попыток исчерпаны: FailedEvent, ack после публикации · Kafka" .-> topic_failed
    device_collector -. "E2. Невалидное сообщение или команда / шард недоступен<br/>после N попыток: FailedEvent · Kafka" .-> topic_failed
    failed_processor -. "E3. Чтение failed-events, смещение после записи · Kafka" .-> topic_failed
    %% S: объектное хранилище MinIO
    failed_processor -. "S1. PutObject If-None-Match: *, метаданные · S3 API" .-> minio
    backup_runner -. "S2. Копии PostgreSQL в backups/postgres/ · S3 API (mc)" .-> minio
    clickhouse -. "S3. Выгрузка копии в backups/clickhouse/ · S3 API" .-> minio
    mimir -. "S4. Blocks и ruler · S3 API" .-> minio
    loki -. "S5. Chunks и индекс · S3 API" .-> minio
    tempo -. "S6. Блоки трейсов · S3 API" .-> minio
    %% C: команды роутерам (router-manager, ADR-0020)
    orchestrator -- "C1. CreateCommand / GetCommand + сервисный JWT · gRPC" --> router_manager
    router -- "C2. PollCommand / ReportResult, подпись HMAC · gRPC (HTTP/2)" --> router_manager
    router_manager -- "C3. «Нет команды» и поколение роутера (Lua) · Redis master" --> redis
    router_manager -- "C4. Выдача SKIP LOCKED, статусы, проход зависших · pgx" --> pg
    router_manager -. "C5. Ключи JWKS (кэш, обновление по kid) · HTTP" .-> keycloak
    camunda -- "Состояние процессов · JDBC" --> pg
    %% M: метрики (Alloy собирает и отправляет в Mimir; экспортёры скрейпит Alloy)
    alloy -. "M1. /actuator/prometheus, все экземпляры (DNS Docker) · HTTP" .-> events_collector
    alloy -. "M1. /actuator/prometheus: devices_*, shard · HTTP" .-> device_collector
    alloy -. "M1. /actuator/prometheus (management-порт): http_server_requests,<br/>device_commands_*, device_cache_* · HTTP" .-> device_service
    alloy -. "M1. /actuator/prometheus: failed_events_archived_*, s3 put-object · HTTP" .-> failed_processor
    alloy -. "M1. /metrics: router_manager_*, grpc_server_* · HTTP" .-> router_manager
    alloy -. "M2. Метрики сервисов · remote write /api/v1/push" .-> mimir
    alloy -. "M1. Скрейп /metrics · HTTP :9187" .-> pg_exporter
    pg_exporter -. "M2. Статистика pg_stat_* · SQL" .-> pg
    pg_exporter -. "M2. pg_stat_*, pg_stat_replication · SQL" .-> shard0
    pg_exporter -. "M2. pg_stat_*, pg_stat_replication · SQL" .-> shard1
    pg_exporter -. "M2. Отставание воспроизведения WAL · SQL" .-> replica0
    pg_exporter -. "M2. Отставание воспроизведения WAL · SQL" .-> replica1
    alloy -. "M1. Метрики Proxy: агент · HTTP" .-> proxy
    alloy -. "M1. Скрейп /metrics · HTTP :9308" .-> kafka_exporter
    kafka_exporter -. "M2. Брокеры, топики, лаг · Kafka protocol" .-> kafka
    alloy -. "M1. Метрики MinIO: cluster и bucket (v3) · HTTP :9000" .-> minio
    alloy -. "M1. Встроенные метрики · HTTP" .-> keycloak
    %% L: логи
    alloy -. "L1. Контейнеры проекта и их stdout/stderr ·<br/>Docker API, фильтр com.docker.compose.project" .-> docker
    alloy -. "L2. Отправка логов · HTTP push :3100" .-> loki
    %% R: трейсы
    apps -. "R1. Трейсы (один трейс: HTTP device-service -> devices -><br/>device-collector-service -> PostgreSQL) · OTLP" .-> alloy
    alloy -. "R2. Батчи трейсов · OTLP gRPC :4317" .-> tempo
    %% Просмотр
    grafana -- "Запросы метрик · PromQL" --> mimir
    grafana -- "Запросы логов; правило RouterManagerCommandStuck<br/>(по экземпляру на command_id) · LogQL" --> loki
    grafana -- "Запросы трейсов · TraceQL" --> tempo
    engineer -- "Дашборды, логи, трейсы · Web UI" --> grafana

