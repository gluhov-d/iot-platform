@startuml Containers
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title C4 Level 2 — Контейнеры IoT-платформы

' Маршруты выделены цветом и нумерацией: T — приём телеметрии, C — выполнение команд, E — обработка ошибок.
' Наблюдаемость: M — метрики, L — логи, R — трейсы
AddRelTag("telemetry", $textColor="#1565C0", $lineColor="#1565C0", $legendText="T: приём телеметрии")
AddRelTag("command",   $textColor="#2E7D32", $lineColor="#2E7D32", $legendText="C: выполнение команд")
AddRelTag("error",     $textColor="#C62828", $lineColor="#C62828", $lineStyle=DashedLine(), $legendText="E: обработка ошибок")
AddRelTag("metrics",   $textColor="#EF6C00", $lineColor="#EF6C00", $lineStyle=DottedLine(), $legendText="M: метрики")
AddRelTag("logs",      $textColor="#6A1B9A", $lineColor="#6A1B9A", $lineStyle=DottedLine(), $legendText="L: логи")
AddRelTag("traces",    $textColor="#00838F", $lineColor="#00838F", $lineStyle=DottedLine(), $legendText="R: трейсы")

Person(engineer, "Инженер", "Регистрирует устройства, отправляет команды, смотрит телеметрию")
System_Ext(device, "IoT-устройство", "Датчик/контроллер: шлёт телеметрию, получает команды")

System_Boundary(platform, "IoT Platform") {

  Boundary(apps, "Прикладные сервисы", "Spring Boot") {
    Container(gateway, "API Gateway", "Spring Cloud Gateway", "Единая точка входа прикладного API: проверка JWT, маршрутизация")
    Container(orchestrator, "API Orchestrator", "Spring Boot", "Сценарии из нескольких шагов: запускает процессы Camunda, агрегирует ответы")

    Container(device_service, "Device Service", "Spring Boot", "Реестр устройств и их статусы")
    Container(command_service, "Command Service", "Spring Boot", "Жизненный цикл команд: NEW → SENT → DONE/FAILED")
    Container(event_service, "Event Service", "Spring Boot", "Чтение телеметрии и событий для API")

    Container(device_collector, "Device Collector", "Spring Boot, MQTT/HTTP adapter", "Протокольный шлюз устройств: принимает MQTT/HTTP, проверяет устройство, публикует в Kafka; доставляет команды устройству")
    Container(events_collector, "events-collector-service", "Spring Boot 4, Kafka consumer", "Модуль 2: events -> ClickHouse (device_events + outbox), фоновая публикация DeviceInfo в devices")
    Container(failed_processor, "Failed Events Processor", "Spring Boot, Kafka consumer", "Разбор DLT: сохраняет сбойные сообщения, повторяет обработку")
  }

    Boundary(kafka, "Kafka", "Message Broker") {
        ContainerQueue(topic_events, "events", "Kafka topic, delete", "Сырые события устройств (Avro DeviceEvent), ключ deviceId")
        ContainerQueue(topic_device, "devices", "Kafka topic, compact", "Обнаруженные устройства (Avro DeviceInfo), ключ deviceId")
        ContainerQueue(topic_dlt, "iot.dlt", "Kafka topic", "Сообщения, которые не удалось обработать (следующие модули)")
    }
    Container(schema_registry, "Schema Registry", "Confluent", "Контракты Avro")

    ContainerDb(pg, "PostgreSQL", "Реляционная БД", "devices, device_commands; БД Keycloak и Camunda")
    ContainerDb(redis, "Redis", "In-Memory", "outbox:lease (аренда публикатора), devices:published; кэш активных устройств")
    ContainerDb(clickhouse, "ClickHouse", "Колоночная БД", "iot_platform: device_events, device_outbox (ReplacingMergeTree)")
    ContainerDb(minio, "MinIO", "Object Storage", "Бакеты iot-dlt, iot-attachments")
    Container(camunda, "Camunda", "BPM Engine", "Процесс выполнения команды: отправка, ожидание подтверждения, таймаут")

    Boundary(obs, "Наблюдаемость") {
        Container(alloy, "Alloy", "Grafana Alloy", "Агент: читает логи контейнеров проекта через Docker API, принимает OTLP-трейсы")
        ContainerDb(loki, "Loki", "Log storage", "Логи с метками service, container, cluster")
        ContainerDb(tempo, "Tempo", "Trace storage", "Трейсы")
        ContainerDb(prometheus, "Prometheus", "TSDB, pull", "Метрики: скрейп каждые 15 с")
        Container(pg_exporter, "postgres-exporter", "Prometheus exporter", "Метрики PostgreSQL на :9187")
        Container(kafka_exporter, "kafka-exporter", "Prometheus exporter", "Метрики Kafka на :9308")
        Container(grafana, "Grafana", "Dashboards", "Дашборды поверх Prometheus, Loki, Tempo")
    }
}

System_Ext(keycloak, "Keycloak", "OIDC-провайдер")
System_Ext(docker, "Docker Engine", "Логи контейнеров, метки Compose-проекта")

' ------------------------------------------------------------------ Вход инженера
Rel(engineer, keycloak, "Вход, получение токена", "OIDC")
Rel(engineer, gateway, "Прикладной API с JWT", "HTTPS/REST")
Rel(gateway, keycloak, "Проверка JWT (JWKS)", "OIDC")
Rel(gateway, orchestrator, "Составные операции", "REST")
Rel(gateway, device_service, "CRUD устройств", "REST")
Rel(gateway, event_service, "Запросы телеметрии", "REST")

' ------------------------------------------------------------------ T: приём телеметрии
Rel(device, device_collector, "T1. Телеметрия", "MQTT/HTTP", $tags="telemetry")
Rel(device_collector, redis, "T2. Устройство известно и активно?", "Redis", $tags="telemetry")
Rel(device_collector, topic_events, "T3. Публикация события", "Kafka, Avro", $tags="telemetry")
Rel(device_collector, schema_registry, "Схемы Avro", "HTTP")
Rel(events_collector, topic_events, "T4. Чтение", "Kafka", $tags="telemetry")
Rel(events_collector, clickhouse, "T5. device_events + outbox, ack после записи", "JDBC/HTTP", $tags="telemetry")
Rel(events_collector, redis, "T6. Аренда публикатора, devices:published", "Redis", $tags="telemetry")
Rel(events_collector, topic_device, "T7. DeviceInfo (outbox)", "Kafka, Avro", $tags="telemetry")
Rel(device_service, topic_device, "T4. Чтение: статус, last_seen", "Kafka", $tags="telemetry")
Rel(device_service, pg, "Реестр устройств", "JDBC")
Rel(device_service, redis, "Обновление кэша активных устройств", "Redis")
Rel(event_service, clickhouse, "Выборки телеметрии", "HTTP/SQL")

' ------------------------------------------------------------------ C: выполнение команд
Rel(orchestrator, camunda, "C1. Запуск процесса команды", "REST", $tags="command")
Rel(camunda, command_service, "C2. Шаг «отправить команду»", "External Task / REST", $tags="command")
Rel(command_service, pg, "C3. Сохранение команды и статуса", "JDBC", $tags="command")
Rel(command_service, device_collector, "C4. Доставить команду", "REST", $tags="command")
Rel(device_collector, device, "C5. Команда устройству", "MQTT/HTTP", $tags="command")
Rel(device, device_collector, "C6. Подтверждение (ack) → events", "MQTT/HTTP", $tags="command")
Rel(command_service, topic_events, "C7. Чтение ack → DONE, завершение шага", "Kafka", $tags="command")
Rel(camunda, pg, "Состояние процессов", "JDBC")

' ------------------------------------------------------------------ E: обработка ошибок
Rel(device_collector, topic_dlt, "E1. Неизвестное устройство / невалидное сообщение", "Kafka", $tags="error")
Rel(events_collector, topic_dlt, "E1. Ошибка записи после ретраев", "Kafka", $tags="error")
Rel(failed_processor, topic_dlt, "E2. Чтение", "Kafka", $tags="error")
Rel(failed_processor, minio, "E3. Исходное сообщение", "S3 API", $tags="error")
Rel(failed_processor, clickhouse, "E3. Запись в dead_letters", "HTTP/SQL", $tags="error")
Rel(failed_processor, topic_events, "E4. Повторная публикация исправимых", "Kafka", $tags="error")
Rel(camunda, command_service, "E5. Таймаут ack → FAILED", "External Task / REST", $tags="error")

' ------------------------------------------------------------------ M: метрики (Prometheus забирает сам, pull)
Rel(prometheus, pg_exporter, "M1. Скрейп /metrics", "HTTP :9187", $tags="metrics")
Rel(pg_exporter, pg, "M2. Статистика pg_stat_*", "SQL", $tags="metrics")
Rel(prometheus, kafka_exporter, "M1. Скрейп /metrics", "HTTP :9308", $tags="metrics")
Rel(kafka_exporter, kafka, "M2. Брокеры, топики, лаг", "Kafka protocol", $tags="metrics")
Rel(prometheus, minio, "M1. Встроенные метрики", "HTTP :9000", $tags="metrics")
Rel(prometheus, keycloak, "M1. Встроенные метрики", "HTTP :9000", $tags="metrics")
Rel(prometheus, alloy, "M1. Собственные метрики (также Loki, Tempo, Grafana)", "HTTP", $tags="metrics")

' ------------------------------------------------------------------ L: логи
Rel(alloy, docker, "L1. Контейнеры проекта и их stdout/stderr", "Docker API, фильтр com.docker.compose.project", $tags="logs")
Rel(alloy, loki, "L2. Отправка логов", "HTTP push :3100", $tags="logs")

' ------------------------------------------------------------------ R: трейсы
Rel(apps, alloy, "R1. Трейсы", "OTLP gRPC :4319 / HTTP :4320", $tags="traces")
Rel(alloy, tempo, "R2. Батчи трейсов", "OTLP gRPC :4317", $tags="traces")

' ------------------------------------------------------------------ Просмотр
Rel(grafana, prometheus, "Запросы метрик", "PromQL")
Rel(grafana, loki, "Запросы логов", "LogQL")
Rel(grafana, tempo, "Запросы трейсов", "TraceQL")
Rel(engineer, grafana, "Дашборды, логи, трейсы", "Web UI")

SHOW_LEGEND()
@enduml
