%% device-collector-service: ошибки — невалидное сообщение, недоступный шард, недоступный failed-events
sequenceDiagram
    autonumber
    participant K as Kafka (devices)
    participant L as DeviceInfoListener
    participant H as DefaultErrorHandler
    participant S as DeviceRegistryService
    participant P as ShardingSphere-Proxy
    participant DB as PostgreSQL shard_N
    participant D as Kafka (failed-events)

    K->>L: poll

    alt Schema Registry недоступен (сеть, 5xx)
        L->>H: DeserializationException - временная
        break повтор без ограничения числа попыток, FailedEvent не создаётся
            Note over H,K: offset не подтверждается, сообщение не теряется
        end
    else не Avro / схема не найдена
        L->>H: DeserializationException - не разобрано
        H->>D: FailedEvent DESERIALIZATION_FAILED, исходные байты, sourceTopic, sourcePartition, sourceOffset
        D-->>H: ack
        H->>K: commit offset после публикации FailedEvent
        break сообщение обработано, дальше схема не идёт
            Note over H,K: FailedEvent опубликован, смещение подтверждено
        end
    else невалидное сообщение
        L->>S: process(record)
        S-->>H: InvalidDeviceInfoException<br/>(ключ ≠ deviceId ≠ device.deviceId, пустые tenantId/deviceType, emittedAtMs ≤ 0)
        H->>D: FailedEvent VALIDATION_FAILED, attempts = 1
        D-->>H: ack
        H->>K: commit offset после публикации FailedEvent
        break сообщение обработано, дальше схема не идёт
            Note over H,K: FailedEvent опубликован, смещение подтверждено
        end
    else шард недоступен / таймаут
        L->>S: process(record)
        S->>P: BEGIN · SELECT … FOR UPDATE
        P->>DB: маршрут |hashCode(device_id)| % 2
        DB--xP: нет соединения / таймаут
        P-->>S: SQLException: шард остановлен - 08003 через 3 с,<br/>statement_timeout - 57014, lock_timeout - 55P03
        S->>P: ROLLBACK (если соединение закрыто - причина остаётся исходной)
        S->>P: PREVIEW SELECT 1 FROM devices WHERE device_id = '…'
        P-->>S: data_source_name = shard_N (маршрут без обращения к узлу,<br/>значение - литералом: параметр PREVIEW Proxy 5.5.3 не учитывает)
        Note over S: devices_shard_route_fail_total{shard=shard_N, reason=connection|timeout|routing}++<br/>devices_processing_errors_total{reason=storage}++ (каждая попытка)<br/>лог status=FAILED, shard, errorClass, errorMessage
        S-->>H: DeviceNotStoredException
        loop повторы до DEVICES_MAX_ATTEMPTS попыток, пауза по DEVICES_RETRY_INTERVAL с ростом DEVICES_RETRY_MULTIPLIER
            H->>L: повтор той же записи
            L->>S: process(record)
            S-->>H: ошибка
        end
        H->>D: FailedEvent STORAGE_UNAVAILABLE, attempts = DEVICES_MAX_ATTEMPTS, DeviceInfo (Avro) или исходные байты, traceId
        alt публикация FailedEvent успешна
            D-->>H: ack
            H->>K: commit offset (commitRecovered=true), раздел обрабатывается дальше
            Note over H: devices_messages_failed_total{reason}++, failed_events_published_total{error_code, error_type}++,<br/>лог status=FAILED_EVENT, shard
            break сообщение обработано, дальше схема не идёт
                Note over H,K: смещение подтверждено
            end
        else failed-events недоступна
            D--xH: ошибка
            break смещение не подтверждается
                Note over H,K: сообщение будет обработано снова, не теряется
            end
        end
    end
    Note over K,D: Сообщения других устройств, в том числе на другом шарде, ждут только паузы повторов.<br/>Возврат объекта из failed-events — необязательная фаза (FR-024), в эту схему не входит
