COMPOSE_PROJECT_NAME=iot-platform

APP_INSTANCE_ID=ide-local
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ---------------------------------------------------------------- Events collector service
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_TTL_MS=30000
OUTBOX_PUBLISH_INTERVAL_MS=2000

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_VERSION=16-alpine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iot_devices
POSTGRES_USER=iot
POSTGRES_PASSWORD=change_me_postgres
# Дополнительные БД, создаются скриптом init/postgres/01-init-databases.sh
POSTGRES_EXTRA_DBS=iot_commands,keycloak,camunda

# ---------------------------------------------------------------- ClickHouse
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123
CLICKHOUSE_DATABASE=iot_platform
CLICKHOUSE_VERSION=26.2.19-alpine
CLICKHOUSE_PLATFORM=linux/amd64
CLICKHOUSE_USERNAME=iot
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9010
MANAGEMENT_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---------------------------------------------------------------- Redis
REDIS_VERSION=8.6.7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
# --------------------------------------------------------------------- Kafka
KAFKA_VERSION=4.2.0
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
# KRaft требует 16-байтный UUID в base64 (22 символа).
# Новый: python3 -c "import base64,uuid; print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
# При смене значения пересоздайте том Kafka: make kafka-reset
KAFKA_CLUSTER_ID=5kF0GeTqS3OtiMbQduwsug
KAFKA_EVENTS_TOPIC=events
KAFKA_DEVICES_TOPIC=devices
KAFKA_CONSUMER_GROUP=events-collector
# Параметры тем для kafka/init-topics.sh
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1

# ----------------------------------------------------------- Schema Registry
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_VERSION=8.2.4

# --------------------------------------------------------------------- MinIO
MINIO_VERSION=RELEASE.2024-10-13T13-34-11Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKETS=iot-dlt,iot-attachments

# ------------------------------------------------------------------ Keycloak
KEYCLOAK_VERSION=26.0
# На Apple Silicon с включённой Rosetta в Docker Desktop нативный arm64-образ
# Keycloak падает с SIGILL в JVM (JDK 21). Запускаем amd64-вариант через эмуляцию.
# На Linux/x86 можно поставить KEYCLOAK_PLATFORM=linux/amd64 без потерь скорости.
KEYCLOAK_PLATFORM=linux/amd64
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak
KEYCLOAK_DB=keycloak

# ------------------------------------------------------------------- Camunda
CAMUNDA_VERSION=run-7.21.0
CAMUNDA_PORT=8088
CAMUNDA_DB=camunda

# ------------------------------------------------------------- Observability
GRAFANA_VERSION=11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

PROMETHEUS_VERSION=v2.54.1
PROMETHEUS_PORT=9090

LOKI_VERSION=3.1.1
LOKI_PORT=3100

TEMPO_VERSION=2.6.0
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

ALLOY_VERSION=v1.4.2
ALLOY_PORT=12345

# --------------------------------------------------------------- Экспортёры
POSTGRES_EXPORTER_VERSION=v0.15.0
POSTGRES_EXPORTER_PORT=9187
KAFKA_EXPORTER_VERSION=v1.9.0
KAFKA_EXPORTER_PORT=9308
# Образ сервиса собирается локально (docker compose build); тег - не latest
EVENTS_COLLECTOR_IMAGE_TAG=0.1.0
# Диапазон хостовых портов: при --scale каждая реплика получает свой
EVENTS_COLLECTOR_PORTS=8085-8087

# ===================================================== Профиль tools
KAFKA_UI_VERSION=v1.5.0
KAFKA_UI_PORT=8090