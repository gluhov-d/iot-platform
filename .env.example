COMPOSE_PROJECT_NAME=iot-platform

APP_INSTANCE_ID=ide-local
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ---------------------------------------------------------------- Events collector service
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_TTL_MS=30000
OUTBOX_PUBLISH_INTERVAL_MS=2000
# Ошибка записи в ClickHouse: всего попыток (включая первую) и пауза перед второй (дальше пауза растёт вдвое),
# затем сообщение уходит в failed-events
EVENTS_MAX_ATTEMPTS=3
EVENTS_RETRY_INTERVAL=1s
# Рост паузы: каждая следующая в столько раз больше предыдущей (1 с, 2 с, 4 с ...)
EVENTS_RETRY_MULTIPLIER=2.0
# Пул соединений с ClickHouse и ожидание свободного соединения, мс
CLICKHOUSE_POOL_SIZE=5
CLICKHOUSE_CONNECTION_TIMEOUT_MS=30000
# Тайм-аут команд Redis
REDIS_TIMEOUT=2s
# Срок жизни карточки в кэше device-service (ключ device:v1:{deviceId})
DEVICE_CACHE_TTL=10m
# Срок жизни порога версии (ключ device:v1:floor:{deviceId}): больше DEVICE_CACHE_TTL и больше худшего ожидаемого
# отставания реплики - иначе старая версия снова попадёт в кэш (ADR-0003)
DEVICE_CACHE_FLOOR_TTL=24h
# Продюсер Kafka (devices и failed-events): ожидание подтверждения отправки (одно сообщение outbox), блокировка при
# отправке, ответ брокера и общий срок доставки (мс)
KAFKA_SEND_TIMEOUT=20s
KAFKA_PRODUCER_MAX_BLOCK_MS=5000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=15000

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_VERSION=16-alpine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iot_devices
POSTGRES_USER=iot
POSTGRES_PASSWORD=change_me_postgres
# Дополнительные БД, создаются скриптом init/postgres/01-init-databases.sh
POSTGRES_EXTRA_DBS=iot_commands,keycloak,camunda

# ---------------------------------------------------------------- ClickHouse
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123
CLICKHOUSE_DATABASE=iot_platform
CLICKHOUSE_VERSION=26.2.19-alpine
CLICKHOUSE_PLATFORM=linux/amd64
CLICKHOUSE_USERNAME=iot
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9010
MANAGEMENT_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---------------------------------------------------------------- Redis
REDIS_VERSION=8.6.7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
# Redis через Sentinel (ADR-0008). Подсеть compose-сети iot-net и статические адреса узлов Redis и Sentinel
# (адреса - в этой подсети; при смене подсети пересоздайте сеть: make down, затем docker network rm iot-net)
IOT_NET_SUBNET=172.29.78.0/24
# Динамические адреса контейнеров - верхняя половина подсети; статические адреса Redis и Sentinel ниже (.10-.23)
IOT_NET_IP_RANGE=172.29.78.128/25
REDIS_MASTER_IP=172.29.78.10
REDIS_REPLICA_IP=172.29.78.11
REDIS_SENTINEL_1_IP=172.29.78.21
REDIS_SENTINEL_2_IP=172.29.78.22
REDIS_SENTINEL_3_IP=172.29.78.23
# Адреса Sentinel, которые узел Redis спрашивает о роли при старте: те же три адреса через запятую
REDIS_SENTINEL_IPS=172.29.78.21,172.29.78.22,172.29.78.23
# Имя основного узла в Sentinel и узлы Sentinel для клиентов (имена сервисов в compose)
REDIS_SENTINEL_MASTER=platform-redis
REDIS_SENTINEL_NODES=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
# Предел памяти узла Redis. Политика volatile-lru: вытесняются только ключи с TTL (кэш устройств, аренда)
REDIS_MAXMEMORY=256mb
# --------------------------------------------------------------------- Kafka
KAFKA_VERSION=4.2.0
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
# KRaft требует 16-байтный UUID в base64 (22 символа).
# Новый: python3 -c "import base64,uuid; print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
# При смене значения пересоздайте том Kafka: make kafka-reset
KAFKA_CLUSTER_ID=5kF0GeTqS3OtiMbQduwsug
KAFKA_EVENTS_TOPIC=events
KAFKA_DEVICES_TOPIC=devices
# Единая тема необработанных сообщений (specs/002-failed-events); subject failed-events-value
KAFKA_FAILED_EVENTS_TOPIC=failed-events
# Срок хранения failed-events (14 суток); тема с cleanup.policy=delete, без сжатия и без retention.bytes
KAFKA_FAILED_EVENTS_RETENTION_MS=1209600000
# Продюсер ошибок обоих сборщиков (failed-events): ожидание подтверждения одной записи, блокировка при отправке,
# ответ брокера и общий срок доставки, мс. Срок ожидания не меньше FAILED_EVENTS_DELIVERY_TIMEOUT_MS
FAILED_EVENTS_PUBLISH_TIMEOUT=15s
FAILED_EVENTS_MAX_BLOCK_MS=5000
FAILED_EVENTS_REQUEST_TIMEOUT_MS=5000
FAILED_EVENTS_DELIVERY_TIMEOUT_MS=15000
KAFKA_CONSUMER_GROUP=events-collector
# Параметры тем для kafka/init-topics.sh
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1
# Тема devices: сжатия нет, сообщения хранятся этот срок (30 суток, ADR-0011) - порядок «команда -> снимок» не теряется.
# Копия шардов старше срока - предупреждение shard-restore.sh
KAFKA_DEVICES_RETENTION_MS=2592000000

# ----------------------------------------------------------- Schema Registry
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_VERSION=8.2.4

# --------------------------------------------------------------------- MinIO
MINIO_IMAGE=pgsty/minio
MINIO_VERSION=RELEASE.2026-08-04T00-00-00Z
# Образ mc для backup-runner (клиент MinIO); тег - не latest
MC_IMAGE=pgsty/mc
MC_VERSION=RELEASE.2026-11-12T00-00-00Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
# Бакеты: имена зашиты в шаблоны политик и ILM (infrastructure/config/minio), init подставляет их из этих переменных
FAILED_EVENTS_BUCKET=failed-events
MINIO_BUCKET_MIMIR=mimir-blocks
MINIO_BUCKET_LOKI=loki-chunks
MINIO_BUCKET_TEMPO=tempo-traces
MINIO_BUCKET_BACKUPS=backups
# Сроки хранения, дни (ILM бакетов). Срок бакета больше срока системы: Mimir 365 < 380, Loki 90 < 100, Tempo 14 < 21
MINIO_EXPIRE_FAILED_EVENTS_DAYS=180
MINIO_EXPIRE_BACKUPS_DAYS=30
MINIO_EXPIRE_MIMIR_DAYS=380
MINIO_EXPIRE_LOKI_DAYS=100
MINIO_EXPIRE_TEMPO_DAYS=21
# Срок блокировки объектов failed-events (Object Lock, равен сроку ILM). Пока не применяется init: решение по R21
FAILED_EVENTS_LOCK_DAYS=180
# Учётки компонентов: имя учётки (ACCESS_KEY) и её секрет (SECRET_KEY). Пароли в .env.example - заглушки change_me_*
FAILED_EVENTS_S3_ACCESS_KEY=failed-events-processor
FAILED_EVENTS_S3_SECRET_KEY=change_me_failed_events_processor
MIMIR_S3_ACCESS_KEY=mimir
MIMIR_S3_SECRET_KEY=change_me_mimir
LOKI_S3_ACCESS_KEY=loki
LOKI_S3_SECRET_KEY=change_me_loki
TEMPO_S3_ACCESS_KEY=tempo
TEMPO_S3_SECRET_KEY=change_me_tempo
BACKUP_POSTGRES_S3_ACCESS_KEY=backup-postgres
BACKUP_POSTGRES_S3_SECRET_KEY=change_me_backup_postgres
BACKUP_CLICKHOUSE_S3_ACCESS_KEY=backup-clickhouse
BACKUP_CLICKHOUSE_S3_SECRET_KEY=change_me_backup_clickhouse

# ---------------------------------------------------------- Процессор failed-events (образ собирается локально)
FAILED_EVENTS_PROCESSOR_IMAGE_TAG=0.1.0
FAILED_EVENTS_PROCESSOR_PORTS=8110-8112
FAILED_EVENTS_CONSUMER_GROUP=failed-events-processor
# Больше FAILED_EVENTS_S3_API_CALL_TIMEOUT (запись в MinIO не должна переживать срок опроса темы)
FAILED_EVENTS_MAX_POLL_INTERVAL_MS=30000
FAILED_EVENTS_RETRY_INITIAL_INTERVAL=500ms
FAILED_EVENTS_RETRY_MAX_INTERVAL=10s
FAILED_EVENTS_RETRY_MULTIPLIER=2.0
FAILED_EVENTS_S3_ENDPOINT=http://minio:9000
FAILED_EVENTS_S3_REGION=us-east-1
FAILED_EVENTS_S3_CONNECT_TIMEOUT=2s
FAILED_EVENTS_S3_API_CALL_TIMEOUT=8s
FAILED_EVENTS_S3_API_CALL_ATTEMPT_TIMEOUT=4s

# ---------------------------------------------------- Mimir, Loki, Tempo, копии
MIMIR_VERSION=3.2.6
# Порт Mimir внутри сети compose (на хост не публикуется: Keycloak уже занимает 8080)
MIMIR_PORT=8080
MIMIR_RETENTION_PERIOD=365d
LOKI_RETENTION_PERIOD=2160h
TEMPO_BLOCK_RETENTION=336h
# Расписание копий PostgreSQL и ClickHouse (cron, UTC)
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_RUNNER_IMAGE_TAG=0.1.0

# ------------------------------------------------------------------ Keycloak
KEYCLOAK_VERSION=26.0.8
# На Apple Silicon с включённой Rosetta в Docker Desktop нативный arm64-образ
# Keycloak падает с SIGILL в JVM (JDK 21). Запускаем amd64-вариант через эмуляцию.
# На Linux/x86 можно поставить KEYCLOAK_PLATFORM=linux/amd64 без потерь скорости.
KEYCLOAK_PLATFORM=linux/amd64
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak
KEYCLOAK_DB=keycloak
# Realm для device-service (infrastructure/config/keycloak/iot-platform-realm.json)
KEYCLOAK_REALM=iot-platform
# iss токенов - один и тот же снаружи и внутри сети Compose: адрес, по которому Keycloak виден с хоста (KC_HOSTNAME, порт - KEYCLOAK_PORT)
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/iot-platform
# Ключи подписи сервис берёт по внутреннему адресу Keycloak в сети Compose
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/iot-platform/protocol/openid-connect/certs
# Аудитория (aud), которую проверяет device-service, допустимое расхождение часов и тайм-ауты запроса ключей подписи
DEVICE_SERVICE_AUDIENCE=device-service
JWT_CLOCK_SKEW=30s
KEYCLOAK_JWK_CONNECT_TIMEOUT=2s
KEYCLOAK_JWK_READ_TIMEOUT=2s
# Секреты клиентов realm: сервис-потребитель (чтение и запись) и сервис только для чтения
DEVICE_SERVICE_CONSUMER_SECRET=change_me_consumer_secret
DEVICE_SERVICE_READER_SECRET=change_me_reader_secret

# ------------------------------------------------------------------- Camunda
CAMUNDA_VERSION=run-7.21.0
CAMUNDA_PORT=8088
CAMUNDA_DB=camunda

# ------------------------------------------------------------- Observability
GRAFANA_VERSION=11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

LOKI_VERSION=3.1.1
LOKI_PORT=3100

TEMPO_VERSION=2.6.0
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

ALLOY_VERSION=v1.4.2
ALLOY_PORT=12345

# --------------------------------------------------------------- Экспортёры
POSTGRES_EXPORTER_VERSION=v0.15.0
POSTGRES_EXPORTER_PORT=9187
KAFKA_EXPORTER_VERSION=v1.9.0
KAFKA_EXPORTER_PORT=9308
# Одноразовая задача публикации avros (Avro-схемы платформы) в Nexus
AVROS_IMAGE_TAG=0.1.0
# Образ сервиса собирается локально (docker compose build); тег - не latest
EVENTS_COLLECTOR_IMAGE_TAG=0.1.0
# Диапазон хостовых портов: при --scale каждая реплика получает свой
EVENTS_COLLECTOR_PORTS=8085-8087
# Consumer group device-collector-service: её offset сохраняют и возвращают shard-backup и shard-restore
DEVICE_COLLECTOR_CONSUMER_GROUP=device-collector
# Ошибка записи в шард: всего попыток (включая первую) и пауза перед второй (дальше пауза растёт вдвое),
# затем сообщение уходит в failed-events
DEVICES_MAX_ATTEMPTS=3
DEVICES_RETRY_INTERVAL=1s
# Рост паузы: каждая следующая в столько раз больше предыдущей (1 с, 2 с, 4 с ...)
DEVICES_RETRY_MULTIPLIER=2.0
# Время события может опережать часы сервиса не больше чем на это значение, иначе сообщение невалидно
DEVICES_MAX_FUTURE_SKEW=1d
# Как долго сервис помнит шард устройства, определённый через Proxy
DEVICES_SHARD_CACHE_TTL=5m
# Пул соединений с Proxy и ожидание свободного соединения, мс
DEVICES_DB_POOL_SIZE=5
DEVICES_DB_CONNECTION_TIMEOUT_MS=2000
# Как часто потребитель темы devices обновляет метаданные (мс): раздел, добавленный к теме у работающей группы,
# сервис начинает читать с начала темы не позже этого срока, без перезапуска и при любом числе экземпляров (ADR-0011)
DEVICES_CONSUMER_METADATA_MAX_AGE_MS=60000

# ===================================================== Реестр устройств
# Шарды PostgreSQL: базы shard_0 и shard_1 (имена совпадают с источниками в конфигурации ShardingSphere-Proxy)
POSTGRES_SHARD_VERSION=18.6-alpine
SHARD_DB_USER=devices
SHARD_DB_PASSWORD=change_me_shard
# Роль replicator: пароль, с которым реплики шардов подключаются для потоковой репликации
SHARD_REPLICATION_PASSWORD=change_me_replica
# Роль exporter (pg_monitor): под ней экспортёры метрик читают статистику шардов и реплик.
# Пароль без пробелов: postgres-exporter не принимает пробел в пароле (malformed dsn); остальные символы допустимы
SHARD_EXPORTER_PASSWORD=change_me_exporter
# Роль device_reader (LOGIN, без pg_read_all_data): пароль на шардах и репликах; под ним Proxy читает реплики (база devices_read)
SHARD_READER_PASSWORD=change_me_reader
# Экспортёр метрик шардов (PostgreSQL 18): v0.15.0 платформенного экспортёра для PostgreSQL 18 не подходит
POSTGRES_SHARD_EXPORTER_VERSION=v0.20.1
# Образ db-migrator собирается локально; тег - не latest
DB_MIGRATOR_IMAGE_TAG=0.1.0
# ShardingSphere-Proxy: приложение подключается к логической базе devices как к PostgreSQL
SHARDINGSPHERE_PROXY_VERSION=5.5.3
SHARDING_PROXY_PORT=3307
SHARDING_PROXY_USER=devices_app
SHARDING_PROXY_PASSWORD=change_me_proxy
# Учётная запись device-service в Proxy: доступна только логическая база devices_read (реплики, ADR-0004)
DEVICES_READ_DB_USER=devices_reader
DEVICES_READ_DB_PASSWORD=change_me_devices_read
# Чтение device-service: логическая база devices_read в Proxy; connectTimeout и socketTimeout - в секундах
DEVICES_READ_DB_URL=jdbc:postgresql://shardingsphere-proxy:3307/devices_read?connectTimeout=2&socketTimeout=3
# Пул чтения device-service (мс): ожидание соединения из пула; отрицательное значение init-fail - не падать при старте, если Proxy не готов
DEVICES_READ_DB_POOL_CONNECTION_TIMEOUT_MS=2000
DEVICES_READ_DB_INIT_FAIL_TIMEOUT_MS=-1
# Сроки на шардах (мс): запрос и ожидание блокировки прерывает сам шард, соединение Proxy с шардом.
# По их истечении обработка устройства прерывается, после повторов сообщение уходит в failed-events
SHARD_STATEMENT_TIMEOUT_MS=5000
SHARD_LOCK_TIMEOUT_MS=3000
SHARD_CONNECTION_TIMEOUT_MS=3000
# Соединение device-collector-service с Proxy (секунды): установка соединения и ожидание ответа.
# DEVICES_DB_SOCKET_TIMEOUT_S держать больше SHARD_STATEMENT_TIMEOUT_MS: сначала должен сработать шард
DEVICES_DB_CONNECT_TIMEOUT_S=3
DEVICES_DB_SOCKET_TIMEOUT_S=15
# device-collector-service: образ собирается локально (тег - не latest), диапазон портов хоста для --scale
DEVICE_COLLECTOR_IMAGE_TAG=0.1.0
DEVICE_COLLECTOR_PORTS=8095-8097

# ===================================================== device-service
# device-service: образ собирается локально (тег - не latest); два экземпляра, диапазон портов хоста
DEVICE_SERVICE_IMAGE_TAG=0.1.0
DEVICE_SERVICE_PORTS=8105-8106
# Management-порт (технические точки: health, prometheus) без токена; на хост не публикуется, доступен из сети Compose.
# Метрики с него собирает Alloy; номер он берёт из этой же переменной (infrastructure/config/alloy/config.alloy)
DEVICE_SERVICE_MANAGEMENT_PORT=8081
# Срок ожидания подтверждения Kafka при PUT, POST и DELETE; по истечении - 503 COMMAND_NOT_ACCEPTED
DEVICE_COMMAND_SEND_TIMEOUT=5s
# Клиент Schema Registry в device-service: соединение и чтение (мс), повторы. Первая команда экземпляра запрашивает
# id схемы; сумма соединение + чтение (без повторов) должна быть меньше DEVICE_COMMAND_SEND_TIMEOUT
SCHEMA_REGISTRY_HTTP_CONNECT_TIMEOUT_MS=1000
SCHEMA_REGISTRY_HTTP_READ_TIMEOUT_MS=2000
SCHEMA_REGISTRY_MAX_RETRIES=0

# ===================================================== Профиль tools
KAFKA_UI_VERSION=v1.5.0
KAFKA_UI_PORT=8090

# ===================================================== Nexus (базовый стенд)
NEXUS_VERSION=3.96.5
NEXUS_PORT=8091
NEXUS_ADMIN_PASSWORD=change_me_nexus_admin
# Пользователь, от имени которого конвейер контрактов публикует артефакты
NEXUS_PUBLISH_USER=contracts-ci
NEXUS_PUBLISH_PASSWORD=change_me_nexus_publish
# Community Edition работает только после принятия EULA: https://links.sonatype.com/products/nxrm/ce-eula
# Прочитайте соглашение и, если согласны, поставьте true - nexus-init примет его через API
NEXUS_ACCEPT_EULA=false