COMPOSE_PROJECT_NAME=iot-platform

APP_INSTANCE_ID=ide-local
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ---------------------------------------------------------------- Events collector service
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_LEASE_TTL_MS=30000
OUTBOX_PUBLISH_INTERVAL_MS=2000
# Ошибка записи в ClickHouse: всего попыток (включая первую) и пауза перед второй (дальше пауза растёт вдвое),
# затем сообщение уходит в events-dlt
EVENTS_MAX_ATTEMPTS=3
EVENTS_RETRY_INTERVAL=1s
# Рост паузы: каждая следующая в столько раз больше предыдущей (1 с, 2 с, 4 с ...)
EVENTS_RETRY_MULTIPLIER=2.0
# Пул соединений с ClickHouse и ожидание свободного соединения, мс
CLICKHOUSE_POOL_SIZE=5
CLICKHOUSE_CONNECTION_TIMEOUT_MS=30000
# Тайм-аут команд Redis
REDIS_TIMEOUT=2s
# Продюсер Kafka (devices и events-dlt): ожидание подтверждения отправки (одно сообщение outbox), блокировка при
# отправке, ответ брокера и общий срок доставки (мс)
KAFKA_SEND_TIMEOUT=20s
KAFKA_PRODUCER_MAX_BLOCK_MS=5000
KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=5000
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=15000

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_VERSION=16-alpine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=iot_devices
POSTGRES_USER=iot
POSTGRES_PASSWORD=change_me_postgres
# Дополнительные БД, создаются скриптом init/postgres/01-init-databases.sh
POSTGRES_EXTRA_DBS=iot_commands,keycloak,camunda

# ---------------------------------------------------------------- ClickHouse
CLICKHOUSE_URL=jdbc:clickhouse://localhost:8123
CLICKHOUSE_DATABASE=iot_platform
CLICKHOUSE_VERSION=26.2.19-alpine
CLICKHOUSE_PLATFORM=linux/amd64
CLICKHOUSE_USERNAME=iot
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9010
MANAGEMENT_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ---------------------------------------------------------------- Redis
REDIS_VERSION=8.6.7-alpine
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis
# --------------------------------------------------------------------- Kafka
KAFKA_VERSION=4.2.0
KAFKA_INTERNAL_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_CONTROLLER_PORT=9093
# KRaft требует 16-байтный UUID в base64 (22 символа).
# Новый: python3 -c "import base64,uuid; print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
# При смене значения пересоздайте том Kafka: make kafka-reset
KAFKA_CLUSTER_ID=5kF0GeTqS3OtiMbQduwsug
KAFKA_EVENTS_TOPIC=events
KAFKA_DEVICES_TOPIC=devices
# Необработанные сообщения events
KAFKA_EVENTS_DLT_TOPIC=events-dlt
# Реестр устройств: необработанные сообщения devices
KAFKA_DEVICES_DLT_TOPIC=devices-dlt
KAFKA_CONSUMER_GROUP=events-collector
# Параметры тем для kafka/init-topics.sh
KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION=1

# ----------------------------------------------------------- Schema Registry
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_VERSION=8.2.4

# --------------------------------------------------------------------- MinIO
MINIO_VERSION=RELEASE.2024-10-13T13-34-11Z
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKETS=iot-dlt,iot-attachments

# ------------------------------------------------------------------ Keycloak
KEYCLOAK_VERSION=26.0
# На Apple Silicon с включённой Rosetta в Docker Desktop нативный arm64-образ
# Keycloak падает с SIGILL в JVM (JDK 21). Запускаем amd64-вариант через эмуляцию.
# На Linux/x86 можно поставить KEYCLOAK_PLATFORM=linux/amd64 без потерь скорости.
KEYCLOAK_PLATFORM=linux/amd64
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak
KEYCLOAK_DB=keycloak

# ------------------------------------------------------------------- Camunda
CAMUNDA_VERSION=run-7.21.0
CAMUNDA_PORT=8088
CAMUNDA_DB=camunda

# ------------------------------------------------------------- Observability
GRAFANA_VERSION=11.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

PROMETHEUS_VERSION=v2.54.1
PROMETHEUS_PORT=9090

LOKI_VERSION=3.1.1
LOKI_PORT=3100

TEMPO_VERSION=2.6.0
TEMPO_HTTP_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

ALLOY_VERSION=v1.4.2
ALLOY_PORT=12345

# --------------------------------------------------------------- Экспортёры
POSTGRES_EXPORTER_VERSION=v0.15.0
POSTGRES_EXPORTER_PORT=9187
KAFKA_EXPORTER_VERSION=v1.9.0
KAFKA_EXPORTER_PORT=9308
# Одноразовая задача публикации avros (Avro-схемы платформы) в Nexus
AVROS_IMAGE_TAG=0.1.0
# Образ сервиса собирается локально (docker compose build); тег - не latest
EVENTS_COLLECTOR_IMAGE_TAG=0.1.0
# Диапазон хостовых портов: при --scale каждая реплика получает свой
EVENTS_COLLECTOR_PORTS=8085-8087
# Consumer group device-collector-service: её offset сохраняют и возвращают shard-backup и shard-restore
DEVICE_COLLECTOR_CONSUMER_GROUP=device-collector
# Ошибка записи в шард: всего попыток (включая первую) и пауза перед второй (дальше пауза растёт вдвое),
# затем сообщение уходит в devices-dlt
DEVICES_MAX_ATTEMPTS=3
DEVICES_RETRY_INTERVAL=1s
# Рост паузы: каждая следующая в столько раз больше предыдущей (1 с, 2 с, 4 с ...)
DEVICES_RETRY_MULTIPLIER=2.0
# Время события может опережать часы сервиса не больше чем на это значение, иначе сообщение невалидно
DEVICES_MAX_FUTURE_SKEW=1d
# Как долго сервис помнит шард устройства, определённый через Proxy
DEVICES_SHARD_CACHE_TTL=5m
# Пул соединений с Proxy и ожидание свободного соединения, мс
DEVICES_DB_POOL_SIZE=5
DEVICES_DB_CONNECTION_TIMEOUT_MS=2000
# Продюсер devices-dlt: блокировка при отправке, ответ брокера и общий срок доставки, мс
DEVICES_DLT_MAX_BLOCK_MS=5000
DEVICES_DLT_REQUEST_TIMEOUT_MS=5000
DEVICES_DLT_DELIVERY_TIMEOUT_MS=15000

# ===================================================== Реестр устройств
# Шарды PostgreSQL: базы shard_0 и shard_1 (имена совпадают с источниками в конфигурации ShardingSphere-Proxy)
POSTGRES_SHARD_VERSION=18.6-alpine
SHARD_DB_USER=devices
SHARD_DB_PASSWORD=change_me_shard
# Роль replicator: пароль, с которым реплики шардов подключаются для потоковой репликации
SHARD_REPLICATION_PASSWORD=change_me_replica
# Роль exporter (pg_monitor): под ней экспортёры метрик читают статистику шардов и реплик.
# Пароль без пробелов: postgres-exporter не принимает пробел в пароле (malformed dsn); остальные символы допустимы
SHARD_EXPORTER_PASSWORD=change...rter
# Экспортёр метрик шардов (PostgreSQL 18): v0.15.0 платформенного экспортёра для PostgreSQL 18 не подходит
POSTGRES_SHARD_EXPORTER_VERSION=v0.20.1
# Образ db-migrator собирается локально; тег - не latest
DB_MIGRATOR_IMAGE_TAG=0.1.0
# ShardingSphere-Proxy: приложение подключается к логической базе devices как к PostgreSQL
SHARDINGSPHERE_PROXY_VERSION=5.5.3
SHARDING_PROXY_PORT=3307
SHARDING_PROXY_USER=devices_app
SHARDING_PROXY_PASSWORD=change_me_proxy
# device-collector-service: образ собирается локально (тег - не latest), диапазон портов хоста для --scale
DEVICE_COLLECTOR_IMAGE_TAG=0.1.0
DEVICE_COLLECTOR_PORTS=8095-8097

# ===================================================== Профиль tools
KAFKA_UI_VERSION=v1.5.0
KAFKA_UI_PORT=8090

# ===================================================== Nexus (базовый стенд)
NEXUS_VERSION=3.96.5
NEXUS_PORT=8091
NEXUS_ADMIN_PASSWORD=change_me_nexus_admin
# Пользователь, от имени которого конвейер контрактов публикует артефакты
NEXUS_PUBLISH_USER=contracts-ci
NEXUS_PUBLISH_PASSWORD=change_me_nexus_publish
# Community Edition работает только после принятия EULA: https://links.sonatype.com/products/nxrm/ce-eula
# Прочитайте соглашение и, если согласны, поставьте true - nexus-init примет его через API
NEXUS_ACCEPT_EULA=false